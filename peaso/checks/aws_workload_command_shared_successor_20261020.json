  "schema": "aws-workload-command-exact-source-successor-v1",
  "shared_functions": {
    "aws.collect": {
      "current_sha256": "c5de517e376361754d1f2ae0627c8e5e82c2eef40edb507263b50591c5cef82d",
      "exact_additions": [
        "    from . import aws_workload_command_runtime_20261020 as workload_commands\n    workload_command_plan = workload_commands.authorize_collector(options, connector.get('scopes') or [])\n    if requirements is not None and workload_commands.KIND in requirements and set(requirements) <= {workload_commands.KIND, 'aws_account'} and workload_command_plan is None:\n        return workload_commands.disabled_snapshot(connector.get('scopes') or [])\n",
        "    workload_command_capture = workload_commands.collect_selected(workload_command_plan, contexts, requests)\n",
        "    collections, metadata = workload_commands.publish(workload_command_capture, workload_command_plan, collections, metadata, options)\n",
        "    if workload_command_plan is None:\n        wanted.discard(workload_commands.KIND)\n    elif workload_commands.KIND not in wanted:\n        workload_command_plan = None\n"
      ],
      "predecessor_sha256": "f1d69dfbea2f945ee343d732af8732f6a779e6b4899dd7011160106dee5378b6"
    },
    "engine._full_selection": {
      "current_sha256": "9ee59a050ed50ef682af43d85b4424f1ba09320ae85d4a5c00bd464c54a9c9fb",
      "exact_additions": [
        "    selected = list(selected) + [c for c in _registry() if c.provider == provider and c.id in {'aws.review.workload.selected_command_literal_secret_indicators', 'gcp.review.cloudrun_job.declared_image_secret_indicators'}]\n"
      ],
      "predecessor_sha256": "9eec5a4ce371aa3cb2fc7d354d8e3423a7401bcda9f4baa503da9ba2f2349cba"
    },
    "engine._request": {
      "current_sha256": "dadda473ab68ca01119e6f14a2eb308b579cdc5b6c9a7c8a6613f1461d08265d",
      "exact_additions": [
        "    from .collectors.aws_workload_command_runtime_20261020 import targets as workload_command_targets\n    workload_command_targets(content_options, connector.get('scopes', []), request.get('checks') or [], connector['provider'])\n",
        "    from .collectors.gcp_cloudrun_job_image_runtime_20261020 import validate_request as validate_cloudrun_job_images\n    validate_cloudrun_job_images(connector, request)\n"
      ],
      "predecessor_sha256": "a3f8b734a87fd8d9efb64d155d641a5a88f3d3b0ed085cadf9366db885d28627"
    },
    "engine._selection": {
      "current_sha256": "0a6d7136244c75ca6a57fcebb370edf0e00e868e275fcf0fb96bf767f67084d1",
      "exact_additions": [
        "    selected = [c for c in selected if c.id not in {'aws.review.workload.selected_command_literal_secret_indicators', 'gcp.review.cloudrun_job.declared_image_secret_indicators'} or checks is not None and c.id in checks]\n"
      ],
      "predecessor_sha256": "e53417d9a4edcfbead54553e0014e95395f7b8312f23feba68f6267ac703ea2b"
    },
    "engine.collect_snapshot": {
      "current_sha256": "7296e9edf09bba4d4a8bc942f5cd0c84bd917aaef49fa4d8c98e1af90ac990d5",
      "exact_additions": [
        "        from .collectors.aws_workload_command_runtime_20261020 import issue_engine_grant as grant_workload_commands, CHECK as WORKLOAD_COMMAND_CHECK, KIND as WORKLOAD_COMMAND_KIND\n        if WORKLOAD_COMMAND_CHECK in named:\n            connector['options']['_content_secret_scan_kinds'].append(WORKLOAD_COMMAND_KIND)\n        grant_workload_commands(connector['options'], connector.get('scopes', []), [c.id for c in selected if c.id in named])\n",
        "            'gcp.review.cloudrun_job.declared_image_secret_indicators': 'cloudrun_job_declared_image',\n",
        "        from .collectors.gcp_cloudrun_job_image_runtime_20261020 import issue_engine_grant as grant_cloudrun_job_images\n        grant_cloudrun_job_images(connector['options'], connector.get('scopes', []), [c.id for c in selected if c.id in named])\n"
      ],
      "predecessor_sha256": "52cc9a387c2be879ab5ed0350bbe2d7e1af2b94f4b00926fbd7500103f6fdc2e"
    },
    "validation.validate_connector": {
      "current_sha256": "9006a85277260f798afb6a4f712d5d70e5a7cb7ae8bd3450dd303ced0d44daeb",
      "exact_additions": [
        "    if 'selected_aws_workload_commands' in options:\n        try:\n            from peaso.collectors.aws_workload_command_runtime_20261020 import targets as workload_command_targets\n            workload_command_targets(options, scopes or [], [], provider)\n        except (ValueError, TypeError, KeyError, AttributeError):\n            raise HTTPException(422, 'Selected AWS commands require exact ECS/classic Batch definition ARN revisions in selected account/Region scopes; images, environment files and EKS Batch are unsupported') from None\n",
        "    if 'selected_cloudrun_job_declared_images' in options:\n        try:\n            if provider != 'gcp':\n                raise ValueError('Selected Job declared images require GCP')\n            from peaso.collectors.gcp_cloudrun_job_image_runtime_20261020 import validate_options as validate_cloudrun_job_images\n            validate_cloudrun_job_images(options, scopes or [])\n        except (ValueError, TypeError, KeyError, AttributeError):\n            raise HTTPException(422, 'Selected Cloud Run Job declared images require exact supported selectors in one explicit project') from None\n"
      ],
      "predecessor_sha256": "7462773a762302d36397c4c879f58ac6af74cc4bfbc9667a9de2c25fe443fceb"
    }
  },
