{
  "$defs": {
    "AgentIssue": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "kind": {
          "enum": [
            "vulnerability",
            "hardening"
          ],
          "title": "Kind",
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "status": {
          "enum": [
            "confirmed",
            "needs_review"
          ],
          "title": "Status",
          "type": "string"
        },
        "description": {
          "maxLength": 2500,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "impact": {
          "maxLength": 12000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Impact",
          "type": "string"
        },
        "recommendation": {
          "maxLength": 12000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Recommendation",
          "type": "string"
        },
        "verification": {
          "maxLength": 12000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Verification",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "minItems": 1,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "title",
        "kind",
        "severity",
        "status",
        "description",
        "impact",
        "recommendation",
        "verification",
        "references"
      ],
      "title": "AgentIssue",
      "type": "object"
    },
    "Exclusion": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "$ref": "#/$defs/Reference"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "reason"
      ],
      "title": "Exclusion",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "enum": [
            "findings",
            "least_privilege",
            "privesc_edges",
            "actions"
          ],
          "title": "Domain",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "id"
      ],
      "title": "Reference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "summary": {
      "maxLength": 12000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Summary",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/AgentIssue"
      },
      "maxItems": 500,
      "title": "Issues",
      "type": "array"
    },
    "exclusions": {
      "items": {
        "$ref": "#/$defs/Exclusion"
      },
      "title": "Exclusions",
      "type": "array"
    },
    "limitations": {
      "items": {
        "maxLength": 12000,
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "summary",
    "issues",
    "exclusions",
    "limitations"
  ],
  "title": "AgentReport",
  "type": "object"
}
