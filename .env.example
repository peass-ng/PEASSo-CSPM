# Optional: leave blank to generate a private persistent token in identity volume.
# Print once with: docker compose exec api cat /var/lib/peaso/identity/local.token
PEASO_LOCAL_TOKEN=
PEASO_PORT=8000
PEASO_SCAN_TIMEOUT_SECONDS=900
PEASO_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
# Native Python run defaults to loopback and .peaso/{state,identity}.
# PEASO_BIND=127.0.0.1
# PEASO_AUTH_MODE=cognito
# PEASO_COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/EXISTING_POOL
# PEASO_COGNITO_CLIENT_ID=EXISTING_CLIENT
# PEASO_STORAGE=dynamodb
# PEASO_DYNAMODB_TABLE=peaso
# PEASO_ARTIFACT_BUCKET=private-peaso-artifacts
# PEASO_CREDENTIAL_SECRET_ARN=Fernet-key-secret-ARN
# PEASO_STRIPE_SECRET_ARN=existing-HackTricks-Stripe-secret-ARN
# PEASO_STRIPE_PRICE_ID=verified-existing-pentester-price-ID
# PEASO_WORKFLOW_ARN=Step-Functions-state-machine-ARN

# Optional AI defaults. Personal Codex sign-in is available in Settings.
# CODEX_ACCESS_TOKEN=
# PEASO_AI_TIMEOUT_SECONDS=300
# PEASO_AI_MAX_CONCURRENCY=2
# Shell-enabled AI is unavailable without a deployment-owned isolation launcher.
# The launcher must be installed in the analyzer image; see docs/ai-review.md.
# PEASO_AI_ISOLATION_LAUNCHER=/usr/local/bin/cspm-ai-isolate
# Hosted AI encryption is separate from connector encryption.
# PEASO_AI_CREDENTIAL_SECRET_ARN=AI-Fernet-key-secret-ARN
# Optional runtime secret: plain token or JSON with an access_token field.
# The runtime AWS identity needs secretsmanager:GetSecretValue on this ARN.
# CODEX_TOKEN_SECRET_ARN=
