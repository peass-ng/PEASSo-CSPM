    "named_before_auth": true,
    "window_seconds": 3600,
    "end": "UTC capture time truncated to whole second; half-open [start,end).",
    "query": "Fixed server-side exact caller/operation grouping, then count per caller and maximum across callers; no approximate dcount or client-side raw-IP processing. Final native resource/workspace grouping binds result identities.",
