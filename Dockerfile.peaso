FROM trufflesecurity/trufflehog:3.92.5@sha256:e0ac39d4854b1668fa982f768440f5a4269828393cddd868e18305ff8c686918 AS secret-scanner
FROM --platform=linux/amd64 ghcr.io/aquasecurity/trivy:0.68.1@sha256:52e6fb1ff6a8232d6ec480ca9dd0b8db6728e252d092cb7712df7103ba09502e AS trivy-cli
FROM node:22-bookworm-slim AS frontend
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# JSON data the frontend imports from the Python package.
COPY peaso/checks/azure_native_evidence_observations.json peaso/checks/gcp_consolidated_secret_profiles_20261020.json \
     peaso/checks/k8s_kubelet_declaration_observed_20261020.json peaso/checks/k8s_kubelet_declaration_unknown_observed_20261020.json \
     /build/peaso/checks/
RUN npm run build

FROM node:22-bookworm-slim AS codex-runtime
RUN npm install --global @openai/codex@0.147.0 @anthropic-ai/claude-code@2.1.304

FROM python:3.12-slim-bookworm AS runtime
ARG AWS_CLI_VERSION=2.38.0
ARG KUBECTL_VERSION=v1.35.9
COPY peaso/container_install_cloud_clis.sh /usr/local/libexec/peaso-install-cloud-clis
RUN sh /usr/local/libexec/peaso-install-cloud-clis
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PEASO_STATE_DIR=/var/lib/peaso/state PEASO_IDENTITY_DIR=/var/lib/peaso/identity
ENV CLOUDSDK_PYTHON=/usr/local/bin/python CLOUDSDK_CONFIG=/tmp/peaso-gcloud AZURE_CONFIG_DIR=/tmp/peaso-azure
WORKDIR /app
COPY --chown=10001:10001 pyproject.toml ./
COPY --chown=10001:10001 peaso/ ./peaso/
COPY --chown=10001:10001 bluepeass/ ./bluepeass/
COPY --chown=10001:10001 scripts/ ./scripts/
COPY --chown=10001:10001 risk_rules/ ./risk_rules/
COPY --chown=10001:10001 infra/aws/sdk-constraints.txt ./infra/aws/sdk-constraints.txt
RUN python -c 'import json,pathlib; [json.loads(path.read_text()) for path in pathlib.Path("peaso").rglob("*.json")]'
COPY --from=codex-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=codex-runtime /usr/local/lib/node_modules/ /usr/local/lib/node_modules/
RUN ln -s /usr/local/lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex
RUN ln -s /usr/local/lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe /usr/local/bin/claude
RUN pip install --no-cache-dir --constraint /app/infra/aws/sdk-constraints.txt ".[ai,hosted]" && groupadd -g 10001 peaso && useradd -u 10001 -g 10001 --no-create-home peaso
USER 10001:10001
RUN python scripts/peaso_test_resources/verify_runtime_bundle.py \
    && aws --version && kubectl version --client=true && gcloud --version && az version
USER root
ENTRYPOINT ["python", "-m", "peaso.server.bootstrap"]

FROM runtime AS collector
RUN test "$(dpkg --print-architecture)" = amd64
COPY --from=trivy-cli /usr/local/bin/trivy /usr/local/bin/trivy
COPY --from=secret-scanner /usr/bin/trufflehog /usr/local/bin/trufflehog
RUN pip install --no-cache-dir --constraint /app/infra/aws/sdk-constraints.txt '.[cloud,hosted,secrets]'
USER 10001:10001
CMD ["python", "-m", "peaso.worker", "collector"]

FROM runtime AS analyzer
RUN pip install --no-cache-dir --constraint /app/infra/aws/sdk-constraints.txt ".[cloud]"
USER 10001:10001
CMD ["python", "-m", "peaso.worker", "analyzer"]

FROM runtime AS api
RUN pip install --no-cache-dir --constraint /app/infra/aws/sdk-constraints.txt '.[hosted]'
COPY --from=frontend /build/frontend/dist /app/peaso/frontend_dist/
ENV PEASO_BIND=0.0.0.0 PEASO_INITIALIZE=1
CMD ["python", "-m", "peaso.server"]
